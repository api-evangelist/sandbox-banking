{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sandbox Banking Glyue Integration Gateway Adapters Value Mappings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Value Mappings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Value Mappings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sandboxbanking.com/api/value-mappings",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Results per page."
              }
            ]
          },
          "docs": "Returns all value mapping tables configured in the platform for translating enumerated values between source and target systems."
        },
        {
          "info": {
            "name": "Create Value Mapping",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.sandboxbanking.com/api/value-mappings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new value mapping table for translating enumerated field values."
        }
      ]
    }
  ],
  "bundled": true
}