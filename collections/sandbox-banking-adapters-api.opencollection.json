{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sandbox Banking Glyue Integration Gateway Adapters API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Adapters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Adapters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sandboxbanking.com/api/adapters"
          },
          "docs": "Returns all banking system and fintech adapters available in the Glyue platform including core banking adapters (Fiserv, Jack Henry, FIS) and fintech connectors (Salesforce, nCino, Encompass)."
        }
      ]
    }
  ],
  "bundled": true
}